DATABASE_URL=postgres://agent:agent@localhost:5455/agent

# ollama | google | anthropic
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
# Optional: override the provider's default models (see DEFAULT_MODELS in packages/core/src/config.ts)
# MODEL_SMALL=qwen3:4b
# MODEL_LARGE=qwen3:14b
# "auto" sends simple questions to the small model (measured: not worth it locally, see docs/adr/006)
# MODEL_ROUTING=off

# Optional fallback providers
GOOGLE_GENERATIVE_AI_API_KEY=
ANTHROPIC_API_KEY=

# Auth.js session signing key (required): generate with `npx auth secret` or `openssl rand -base64 32`
AUTH_SECRET=

# MCP server over HTTP (npm run mcp:http): shared secret for signing caller-identity tokens (>= 16 chars)
MCP_TOKEN_SECRET=
# MCP_PORT=3333

# Optional, Docker only (`docker compose up`): host ports, and where containers reach Ollama
# WEB_PORT=3000
# DOCKER_OLLAMA_BASE_URL=http://host.docker.internal:11434
# Directory for downloaded embedding/reranker models (containers use a volume at /models)
# MODEL_CACHE_DIR=

# Optional Langfuse export (traces are always stored in the local `traces`/`spans` tables)
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
