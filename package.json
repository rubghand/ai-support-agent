{
  "name": "ai-support-agent",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run dev -w @app/web",
    "build": "npm run build -w @app/web",
    "lint": "eslint . && npm run lint -w @app/web",
    "typecheck": "tsc --noEmit -p . && npm run typecheck --workspaces --if-present",
    "kb:lint": "tsx scripts/kb-lint.ts",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose up -d --wait db",
    "db:generate": "npm run generate -w @app/db",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/db-migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env scripts/db-seed.ts",
    "ingest": "tsx --env-file-if-exists=.env scripts/ingest.ts",
    "search": "tsx --env-file-if-exists=.env scripts/search.ts",
    "eval:retrieval": "tsx --env-file-if-exists=.env evals/retrieval.ts",
    "setup": "npm run db:up && npm run db:migrate && npm run db:seed && npm run ingest"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@types/node": "^22",
    "eslint": "^9",
    "prettier": "^3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "typescript-eslint": "^8",
    "vitest": "^3"
  }
}
